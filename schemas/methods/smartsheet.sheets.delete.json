        "FieldTitle": {
          "type": "string",
          "description": "@fieldId 映射"
        },
        "computedKeyType": {
          "type": "string",
          "description": "计算 key 的类型"
        },
        "fieldId": {
          "type": "string",
          "description": "和对应列比较时生效"
        },
        "value": {
          "type": "object",
          "$ref": "OaConditionValue",
          "description": "和具体值比较时生效"
        },
        "valueType": {
          "type": "string",
          "description": "值类型"
        }
      }
