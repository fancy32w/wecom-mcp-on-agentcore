            "type": "string"
          }
        }
      }
    },
    "OaSmartSheetBatchUpdateSchemaReq": {
      "type": "object",
      "description": "OaSmartSheetBatchUpdateSchema (修改智能表格结构)",
      "properties": {
        "docid": {
          "type": "string",
          "description": "支持文档的 docid 和 url",
          "minLength": 5
        },
        "fields": {
          "type": "array",
          "description": "列信息，不传则不修改列",
          "items": {
            "type": "object",
            "$ref": "OaField"
          },
          "minItems": 0,
          "maxItems": 150
        },
        "new_sheet_title": {
          "type": "string",
          "description": "新子表名称"
        },
        "sheet_id": {
          "type": "string",
          "description": "子表 ID，type=update/delete 时必传，type=add 时不传",
          "minLength": 1,
          "maxLength": 200
        },
        "sheet_title": {
          "type": "string",
          "description": "子表名称，type=add 时必传，不传则不设置",
          "maxLength": 255
        },
        "sheet_type": {
          "type": "string",
          "description": "子表类型，不传则默认为 smartsheet",
          "enum": [
            "smartsheet",
            "dashboard"
          ]
        },
        "type": {
          "type": "string",
          "description": "操作类型，可由 url 推断或 payload 显式传入",
          "enum": [
            "add",
            "update",
            "delete"
          ]
        }
      },
      "required": [
        "docid"
      ]
    },
    "OaLookupFilter": {
      "type": "object",
      "description": "查找引用字段过滤器（对齐下游 LookupFilter）",
      "properties": {
        "conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "OaLookupCondition"
          }
        },
        "conjunction": {
          "type": "string",
          "description": "组合方式，改成 string 兼容"
        }
      }
    },
    "OaTwoWayLinkRecordsFieldProperty": {
      "type": "object",
      "description": "双向关联字段属性，field_type=twowaylinkrecords 时有效（对齐下游 TwoWayLinkRecordsFieldProperty）",
