        "field_id": {
          "type": "string",
          "description": "关联的字段 ID"
        },
        "field_title": {
          "type": "string",
          "description": "关联的字段标题"
        },
        "is_multiple": {
          "type": "boolean",
          "description": "是否允许多选"
        },
        "pad_id": {
          "type": "string",
          "description": "关联的文档 ID，为空时表示关联当前文档"
        },
        "sub_id": {
          "type": "string",
          "description": "关联的子表 ID，为空时表示关联本子表"
        },
        "sub_title": {
          "type": "string",
          "description": "关联的子表标题"
        },
        "view_id": {
          "type": "string",
          "description": "视图 ID"
        }
      }
    },
