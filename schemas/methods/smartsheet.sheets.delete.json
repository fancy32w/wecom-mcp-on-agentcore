          "type": "boolean",
          "description": "是否使用千位符"
        }
      }
    },
    "OaConditionValue": {
      "type": "object",
      "description": "查找引用过滤条件值（对齐下游 ConditionValue）\n说明：下游中 valueImages / valueAttachment / valueUsers 等使用 google.protobuf.Value/ListValue，\n为避免上游引入 protobuf well-known types 与裸结构对不齐，统一以 JSON 字符串表达，\n由调用方自行 JSON 序列化（与 OaRecordValue.value 一致策略）。\n字段编号严格对齐下游 ConditionValue（25/26 在下游 reserved，此处也保留）。",
      "properties": {
        "valueAttachment": {
          "type": "string",
          "description": "附件，JSON 序列化字符串"
        },
        "valueBarcode": {
          "type": "object",
          "$ref": "OaStringValue",
          "description": "条码"
        },
        "valueCheckbox": {
          "type": "object",
          "$ref": "OaBoolValue",
          "description": "复选框值"
        },
        "valueCreatedTime": {
          "type": "string",
          "description": "创建时间，JSON 序列化字符串"
        },
        "valueCreatedUser": {
          "type": "string",
          "description": "创建者，JSON 序列化字符串"
        },
        "valueDateTime": {
          "type": "object",
          "$ref": "OaFilterDateTimeValue",
          "description": "日期值"
        },
        "valueEmail": {
          "type": "object",
          "$ref": "OaStringValue",
          "description": "邮箱"
        },
        "valueFormula": {
          "type": "string",
          "description": "公式，JSON 序列化字符串"
        },
        "valueImages": {
          "type": "string",
          "description": "图片，JSON 序列化字符串"
        },
        "valueLocation": {
          "type": "string",
          "description": "地理位置，JSON 序列化字符串"
        },
        "valueLookup": {
          "type": "string",
          "description": "查找引用，JSON 序列化字符串"
        },
        "valueModifiedTime": {
          "type": "string",
          "description": "修改时间，JSON 序列化字符串"
        },
        "valueModifiedUser": {
          "type": "string",
          "description": "修改者，JSON 序列化字符串"
        },
        "valueNumber": {
          "type": "object",
          "$ref": "OaNumberValue",
          "description": "数字值"
        },
        "valuePercentage": {
          "type": "object",
          "$ref": "OaNumberValue",
          "description": "百分数"
        },
        "valuePhoneNumber": {
          "type": "object",
          "$ref": "OaStringValue",
          "description": "电话"
        },
        "valueProgress": {
          "type": "string",
          "description": "进度，JSON 序列化字符串"
        },
        "valueReference": {
          "type": "object",
          "$ref": "OaStringValue",
          "description": "关联"
        },
        "valueSelects": {
          "type": "string",
          "description": "多选，JSON 序列化字符串"
        },
        "valueSingleSelect": {
          "type": "string",
          "description": "单选，JSON 序列化字符串"
        },
        "valueText": {
          "type": "object",
          "$ref": "OaStringValue",
          "description": "文本值"
        },
        "valueTitle": {
          "type": "object",
          "$ref": "OaStringValue",
          "description": "标题"
        },
        "valueTwoWayLinkRecords": {
          "type": "object",
          "$ref": "OaStringValue",
          "description": "双向关联"
        },
        "valueUrl": {
          "type": "string",
          "description": "超链接，JSON 序列化字符串"
        },
        "valueUsers": {
          "type": "string",
          "description": "成员列表，JSON 序列化字符串"
        },
        "valueUsersC": {
          "type": "string",
          "description": "成员（兼容字段），JSON 序列化字符串"
        }
      }
