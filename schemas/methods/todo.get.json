{
  "method": "todo.get",
  "description": "批量读取待办详情，返回标题/描述/参与人/时间等",
  "request": {
    "$ref": "TodoGetDetailReq"
  },
  "response": {
    "$ref": "TodoGetDetailRsp"
  },
  "schemas": {
    "TodoGetDetailItem": {
      "type": "object",
      "description": "GetTodoDetail",
      "properties": {
        "todo_id": {
          "type": "string",
          "description": "待办 id"
        }
      }
    },
    "TodoGetDetailReq": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "description": "待办 id 列表，最多20个",
          "items": {
            "type": "object",
            "$ref": "TodoGetDetailItem"
          },
          "minItems": 1,
          "maxItems": 20
        }
      }
    },
    "UserInfoRsp": {
      "type": "object",
      "description": "用户信息",
      "properties": {
        "user_name": {
          "type": "string",
          "description": "用户 userid对应成员的名称"
        },
        "userid": {
          "type": "string",
          "description": "用户 userid"
        }
      }
    },
    "TodoGetDetailRsp": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "description": "待办数据列表，最多20条",
          "items": {
            "type": "object",
            "$ref": "TodoGetDetailResultItem"
          }
        },
        "items_count": {
          "type": "integer",
          "description": "待办数据列表，最多20条 数组元素数量（框架自动生成）"
        }
      }
    },
    "TodoGetDetailResultItem": {
      "type": "object",
      "properties": {
        "create_time": {
          "type": "string",
          "description": "创建时间，格式：YYYY-MM-DD HH:mm:ss"
        },
        "creator": {
          "type": "object",
          "$ref": "UserInfoRsp",
          "description": "创建人信息对象"
        },
        "deadline": {
          "type": "object",
          "$ref": "Deadline",
          "description": "截止时间"
        },
        "description": {
          "type": "string",
          "description": "待办描述"
        },
        "errmsg": {
          "type": "string",
          "description": "错误信息（success=false 时有值）"
        },
        "extra_info": {
          "type": "string",
          "description": "补充信息，例如：将会在 YYYY-MM-DD HH:mm:ss 时间提醒"
        },
        "followers": {
          "type": "array",
          "description": "参与人列表",
          "items": {
            "type": "object",
            "$ref": "TodoFollowerRsp"
          }
        },
        "source": {
          "type": "string",
          "description": "待办来源",
          "enum": [
            "single_chat",
            "group_chat",
            "doc",
            "ai_summary",
            "meeting_summary",
            "face_chat",
            "fused_doc",
            "smart_sheet",
            "smart_doc",
            "JSAPI"
          ]
        },
        "status": {
          "type": "string",
          "description": "待办状态",
          "enum": [
            "finished",
            "proceed",
            "deleted"
          ]
        },
        "success": {
          "type": "boolean",
          "description": "是否成功"
        },
        "title": {
          "type": "string",
          "description": "待办标题"
        },
        "todo_id": {
          "type": "string",
          "description": "待办 id"
        },
        "update_time": {
          "type": "string",
          "description": "更新时间，格式：YYYY-MM-DD HH:mm:ss"
        },
        "user_status": {
          "type": "string",
          "description": "用户状态",
          "enum": [
            "reject",
            "accept",
            "finished",
            "removed",
            "notshow"
          ]
        }
      }
    },
    "Deadline": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "description": "截止时间类型：date=日期，datetime=具体时刻",
          "enum": [
            "date",
            "datetime"
          ]
        },
        "value": {
          "type": "string",
          "description": "截止时间字符串：date=YYYY-MM-DD，datetime=YYYY-MM-DD HH:mm:ss",
          "minLength": 1,
          "maxLength": 32
        }
      }
    },
    "TodoFollowerRsp": {
      "type": "object",
      "description": "参与人信息",
      "properties": {
        "update_time": {
          "type": "string",
          "description": "更新时间，格式：YYYY-MM-DD HH:mm:ss, todo create 不返回"
        },
        "user_name": {
          "type": "string",
          "description": "参与人 userid对应成员的名称"
        },
        "user_status": {
          "type": "string",
          "description": "参与人状态, todo create 不返回",
          "enum": [
            "reject",
            "accept",
            "finished",
            "removed",
            "notshow"
          ]
        },
        "userid": {
          "type": "string",
          "description": "参与人 userid"
        }
      }
    }
  }
}