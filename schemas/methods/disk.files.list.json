{
  "method": "disk.files.list",
  "description": "列出当前用户在微盘中最近浏览过的文件，按最后浏览时间倒序返回，支持分页",
  "request": {
    "$ref": "DiskFileListRecentReq"
  },
  "response": {
    "$ref": "DiskFileListRecentRsp"
  },
  "schemas": {
    "DiskFileListRecentRsp": {
      "type": "object",
      "properties": {
        "error": {
          "type": "object",
          "$ref": "ClawToolError"
        },
        "files": {
          "type": "array",
          "description": "文件列表",
          "items": {
            "type": "object",
            "$ref": "DiskItemInfo"
          }
        },
        "files_count": {
          "type": "integer",
          "description": "文件列表 数组元素数量（框架自动生成）"
        },
        "has_more": {
          "type": "boolean",
          "description": "是否还有更多数据"
        },
        "next_cursor": {
          "type": "string",
          "description": "下一页的游标"
        }
      }
    },
    "DiskItemInfo": {
      "type": "object",
      "description": "微盘文件条目基础信息，用于读取微盘文件信息返回",
      "properties": {
        "create_time": {
          "type": "string",
          "description": "创建时间，格式 YYYY-MM-DD HH:mm:ss"
        },
        "creator_userid": {
          "type": "string",
          "description": "创建者 id，可能是成员、外部联系人、机器人或应用"
        },
        "doc_url": {
          "type": "string",
          "description": "文档打开链接，仅在线文档类型时填充"
        },
        "docid": {
          "type": "string",
          "description": "文档id，仅 type=smartsheet / smartpage / sheet / word / ppt / collect / journal 时有意义"
        },
        "file_name": {
          "type": "string",
          "description": "文件名称"
        },
        "file_size": {
          "type": "integer",
          "description": "文件大小，单位字节；仅 file_type=file 时有意义",
          "format": "uint64"
        },
        "folder_id": {
          "type": "string",
          "description": "所在文件夹 ID，可能为文件夹 file_id 或空间 space_id"
        },
        "folder_name": {
          "type": "string",
          "description": "所在父文件夹名；对父文件夹有权限时才返回，与 folder_id 同时出现"
        },
        "id": {
          "type": "string",
          "description": "微盘文件 ID / 文件夹 ID / 空间 ID"
        },
        "path": {
          "type": "string",
          "description": "文件完整路径"
        },
        "space_id": {
          "type": "string",
          "description": "所属知识空间 ID"
        },
        "space_name": {
          "type": "string",
          "description": "所在空间名；对空间有权限时才返回，与 space_id 同时出现"
        },
        "type": {
          "type": "string",
          "description": "文件类型",
          "enum": [
            "file",
            "folder",
            "space",
            "smartsheet",
            "smartpage",
            "sheet",
            "word",
            "ppt",
            "collect",
            "journal",
            "flow",
            "mind"
          ]
        },
        "update_time": {
          "type": "string",
          "description": "最后更新时间，格式 YYYY-MM-DD HH:mm:ss"
        }
      }
    },
    "DiskFileListRecentReq": {
      "type": "object",
      "properties": {
        "cursor": {
          "type": "string",
          "description": "分页游标；不传或传空串则获取首页数据",
          "minLength": 0,
          "maxLength": 1024
        },
        "limit": {
          "type": "integer",
          "description": "每页返回的最大条数；不传则使用服务默认值",
          "format": "uint32",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "ClawToolError": {
      "type": "object",
      "description": "业务 payload 内层错误（外层框架错误见 OpenClawHttpCallRsp.Error）。",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int64"
        },
        "data": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    }
  }
}