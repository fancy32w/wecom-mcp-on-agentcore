{
  "method": "smartsheet.fields.list",
  "description": "拉取智能表格的字段列表",
  "request": {
    "$ref": "OaSmartSheetGetDataReq"
  },
  "response": {
    "$ref": "OaSmartSheetGetDataTypedRsp"
  },
  "schemas": {
    "OaReferenceFieldProperty": {
      "type": "object",
      "properties": {
        "field_title": {
          "type": "string",
          "description": "字段标题"
        },
        "filed_id": {
          "type": "string",
          "description": "关联的字段 ID"
        },
        "is_multiple": {
          "type": "boolean",
          "description": "是否允许多选"
        },
        "sub_id": {
          "type": "string",
          "description": "关联的子表 ID"
        },
        "sub_title": {
          "type": "string",
          "description": "子表标题"
        },
        "view_id": {
          "type": "string",
          "description": "视图 ID"
        }
      }
    },
    "OaStringValue": {
      "type": "object",
      "properties": {
        "value": {
          "type": "array",
          "description": "字符串值列表",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "OaUserFieldProperty": {
      "type": "object",
      "properties": {
        "is_multiple": {
          "type": "boolean",
          "description": "允许添加多个人员"
        },
        "is_notified": {
          "type": "boolean",
          "description": "添加人员时通知用户"
        }
      }
    },
    "OaViewColorCondition": {
      "type": "object",
      "properties": {
        "color": {
          "type": "string",
          "description": "颜色"
        },
        "condition": {
          "type": "object",
          "$ref": "OaCondition",
          "description": "判断条件"
        },
        "id": {
          "type": "string",
          "description": "填色 ID"
        },
        "type": {
          "type": "string",
          "description": "填色类型"
        }
      }
    },
    "OaGroupSpec": {
      "type": "object",
      "properties": {
        "groups": {
          "type": "array",
          "description": "分组字段列表",
          "items": {
            "type": "object",
            "$ref": "OaGroupInfo"
          }
        }
      }
    },
    "OaCurrencyFieldProperty": {
      "type": "object",
      "properties": {
        "currency_type": {
          "type": "string",
          "description": "货币类型"
        },
        "decimal_places": {
          "type": "integer",
          "description": "小数点位数",
          "format": "int32"
        },
        "use_separate": {
          "type": "boolean",
          "description": "是否使用千位符"
        }
      }
    },
    "OaViewColorConfig": {
      "type": "object",
      "properties": {
        "conditions": {
          "type": "array",
          "description": "填色条件列表",
          "items": {
            "type": "object",
            "$ref": "OaViewColorCondition"
          }
        }
      }
    },
    "OaSortInfo": {
      "type": "object",
      "properties": {
        "desc": {
          "type": "boolean",
          "description": "是否降序"
        },
        "field_id": {
          "type": "string",
          "description": "字段 ID"
        },
        "field_title": {
          "type": "string",
          "description": "字段标题"
        }
      }
    },
    "OaGroupInfo": {
      "type": "object",
      "properties": {
        "desc": {
          "type": "boolean",
          "description": "是否降序"
        },
        "field_id": {
          "type": "string",
          "description": "字段 ID"
        },
        "field_title": {
          "type": "string",
          "description": "字段标题"
        }
      }
    },
    "OaRecord": {
      "type": "object",
      "description": "行完整记录（SmartSheetGetData Response 中 type=records 时返回，含元数据）\n原始 proto3 类型: map<string, google.protobuf.Value>",
      "properties": {
        "create_time": {
          "type": "string",
          "description": "创建时间"
        },
        "creator_name": {
          "type": "string",
          "description": "创建者名字"
        },
        "record_id": {
          "type": "string",
          "description": "记录 ID"
        },
        "update_time": {
          "type": "string",
          "description": "更新时间"
        },
        "updater_name": {
          "type": "string",
          "description": "最后编辑者名字"
        },
        "values": {
          "type": "object",
          "description": "记录内容（key: 字段标题/ID, value: JSON 序列化的值）",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "OaField": {
      "type": "object",
      "description": "列（字段）属性信息",
      "properties": {
        "field_id": {
          "type": "string",
          "description": "字段 ID"
        },
        "field_title": {
          "type": "string",
          "description": "字段标题"
        },
        "field_type": {
          "type": "string",
          "description": "字段类型, 不要校验了，要不很容易和下游对不齐。"
        },
        "new_field_title": {
          "type": "string",
          "description": "新字段名称"
        },
        "property_attachment": {
          "type": "object",
          "$ref": "OaAttachmentFieldProperty"
        },
        "property_auto_number": {
          "type": "object",
          "$ref": "OaAutoNumberFieldProperty"
        },
        "property_barcode": {
          "type": "object",
          "$ref": "OaBarcodeFieldProperty"
        },
        "property_checkbox": {
          "type": "object",
          "$ref": "OaCheckboxFieldProperty"
        },
        "property_created_time": {
          "type": "object",
          "$ref": "OaCreatedTimeFieldProperty"
        },
        "property_currency": {
          "type": "object",
          "$ref": "OaCurrencyFieldProperty"
        },
        "property_date_time": {
          "type": "object",
          "$ref": "OaDateTimeFieldProperty"
        },
        "property_formula": {
          "type": "object",
          "$ref": "OaFormulaFieldProperty",
          "description": "公式字段属性，field_type=formula 时有效"
        },
        "property_location": {
          "type": "object",
          "$ref": "OaLocationFieldProperty"
        },
        "property_lookup": {
          "type": "object",
          "$ref": "OaLookupFieldProperty",
          "description": "查找引用字段属性，field_type=lookup 时有效"
        },
        "property_modified_time": {
          "type": "object",
          "$ref": "OaModifiedTimeFieldProperty"
        },
        "property_number": {
          "type": "object",
          "$ref": "OaNumberFieldProperty"
        },
        "property_percentage": {
          "type": "object",
          "$ref": "OaPercentageFieldProperty"
        },
        "property_progress": {
          "type": "object",
          "$ref": "OaProgressFieldProperty"
        },
        "property_reference": {
          "type": "object",
          "$ref": "OaReferenceFieldProperty"
        },
        "property_select": {
          "type": "object",
          "$ref": "OaSelectFieldProperty"
        },
        "property_single_select": {
          "type": "object",
          "$ref": "OaSingleSelectFieldProperty"
        },
        "property_two_way_link_records": {
          "type": "object",
          "$ref": "OaTwoWayLinkRecordsFieldProperty",
          "description": "双向关联字段属性，field_type=twowaylinkrecords 时有效"
        },
        "property_url": {
          "type": "object",
          "$ref": "OaUrlFieldProperty"
        },
        "property_user": {
          "type": "object",
          "$ref": "OaUserFieldProperty"
        },
        "property_ww_group": {
          "type": "object",
          "$ref": "OaWwGroupFieldProperty"
        }
      }
    },
    "OaSelectFieldProperty": {
      "type": "object",
      "properties": {
        "is_quick_add": {
          "type": "boolean",
          "description": "是否允许填写时新增选项"
        },
        "options": {
          "type": "array",
          "description": "选项列表",
          "items": {
            "type": "object",
            "$ref": "OaOption"
          }
        }
      }
    },
    "OaNumberValue": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number",
          "description": "数字值",
          "format": "double"
        }
      }
    },
    "OaBoolValue": {
      "type": "object",
      "properties": {
        "value": {
          "type": "boolean",
          "description": "布尔值"
        }
      }
    },
    "OaDateTimeFieldProperty": {
      "type": "object",
      "properties": {
        "auto_fill": {
          "type": "boolean",
          "description": "新建记录时是否自动填充时间"
        },
        "format": {
          "type": "string",
          "description": "日期格式"
        }
      }
    },
    "OaBarcodeFieldProperty": {
      "type": "object",
      "properties": {
        "mobile_scan_only": {
          "type": "boolean",
          "description": "仅限手机扫描录入"
        }
      }
    },
    "OaCreatedTimeFieldProperty": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "description": "日期格式"
        }
      }
    },
    "OaCondition": {
      "type": "object",
      "properties": {
        "bool_value": {
          "type": "object",
          "$ref": "OaBoolValue",
          "description": "布尔值"
        },
        "date_time_value": {
          "type": "object",
          "$ref": "OaFilterDateTimeValue",
          "description": "日期值"
        },
        "field_id": {
          "type": "string",
          "description": "字段 ID"
        },
        "field_title": {
          "type": "string",
          "description": "字段标题"
        },
        "field_type": {
          "type": "string",
          "description": "字段类型"
        },
        "number_value": {
          "type": "object",
          "$ref": "OaNumberValue",
          "description": "数字值"
        },
        "operator": {
          "type": "string",
          "description": "判断类型"
        },
        "string_value": {
          "type": "object",
          "$ref": "OaStringValue",
          "description": "文本值"
        },
        "user_value": {
          "type": "object",
          "$ref": "OaUserValue",
          "description": "成员值"
        }
      }
    },
    "OaLookupConditionMatchValue": {
      "type": "object",
      "description": "查找引用匹配值（对齐下游 LookupConditionMatchValue）",
      "properties": {
        "FieldTitle": {
          "type": "string",
          "description": "@fieldId 映射"
        },
        "computedKeyType": {
          "type": "string",
          "description": "计算 key 的类型"
        },
        "fieldId": {
          "type": "string",
          "description": "和对应列比较时生效"
        },
        "value": {
          "type": "object",
          "$ref": "OaConditionValue",
          "description": "和具体值比较时生效"
        },
        "valueType": {
          "type": "string",
          "description": "值类型"
        }
      }
    },
    "OaModifiedTimeFieldProperty": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "description": "日期格式"
        }
      }
    },
    "OaLookupFilter": {
      "type": "object",
      "description": "查找引用字段过滤器（对齐下游 LookupFilter）",
      "properties": {
        "conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "OaLookupCondition"
          }
        },
        "conjunction": {
          "type": "string",
          "description": "组合方式，改成 string 兼容"
        }
      }
    },
    "OaPercentageFieldProperty": {
      "type": "object",
      "properties": {
        "decimal_places": {
          "type": "integer",
          "description": "小数点位数",
          "format": "int32"
        },
        "use_separate": {
          "type": "boolean",
          "description": "是否使用千位符"
        }
      }
    },
    "OaViewProperty": {
      "type": "object",
      "properties": {
        "auto_sort": {
          "type": "boolean",
          "description": "记录变更后自动重新排序"
        },
        "color_config": {
          "type": "object",
          "$ref": "OaViewColorConfig",
          "description": "填色设置"
        },
        "field_visibility": {
          "type": "object",
          "description": "字段可见性，map key 支持 field_id / field_title 双形态",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "filter_spec": {
          "type": "object",
          "$ref": "OaFilterSpec",
          "description": "过滤设置"
        },
        "frozen_field_count": {
          "type": "integer",
          "description": "冻结列数量",
          "format": "int32"
        },
        "group_spec": {
          "type": "object",
          "$ref": "OaGroupSpec",
          "description": "分组设置"
        },
        "is_field_stat_enabled": {
          "type": "boolean",
          "description": "是否使用数据统计"
        },
        "sort_spec": {
          "type": "object",
          "$ref": "OaSortSpec",
          "description": "排序设置"
        }
      }
    },
    "OaSortSpec": {
      "type": "object",
      "properties": {
        "sort_infos": {
          "type": "array",
          "description": "排序字段列表",
          "items": {
            "type": "object",
            "$ref": "OaSortInfo"
          }
        }
      }
    },
    "OaFilterDateTimeValue": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "description": "日期类型"
        },
        "value": {
          "type": "array",
          "description": "日期值",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "OaFilterSpec": {
      "type": "object",
      "properties": {
        "conditions": {
          "type": "array",
          "description": "判断条件",
          "items": {
            "type": "object",
            "$ref": "OaCondition"
          }
        },
        "conjunction": {
          "type": "string",
          "description": "组合方式"
        }
      }
    },
    "OaLookupCondition": {
      "type": "object",
      "description": "查找引用过滤条件（对齐下游 LookupCondition，字段名 lower camelCase 与下游一致）",
      "properties": {
        "conditionId": {
          "type": "string",
          "description": "条件 ID"
        },
        "fieldId": {
          "type": "string",
          "description": "列 ID"
        },
        "fieldTitle": {
          "type": "string",
          "description": "列标题（与 fieldId 二选一，优先使用 fieldId）"
        },
        "fieldType": {
          "type": "string",
          "description": "列类型（可能用于列类型变化时判断）"
        },
        "matchValue": {
          "type": "object",
          "$ref": "OaLookupConditionMatchValue",
          "description": "用于匹配的值"
        },
        "operator": {
          "type": "string",
          "description": "操作符和筛选复用，转为公式时需要注意类型差别"
        }
      }
    },
    "OaChartCategory": {
      "type": "object",
      "description": "图表的类别字段配置",
      "properties": {
        "field_id": {
          "type": "string",
          "description": "类别字段 ID"
        },
        "field_title": {
          "type": "string",
          "description": "类别字段名称"
        },
        "sub_field_id": {
          "type": "string",
          "description": "二级类别字段 ID"
        },
        "sub_field_title": {
          "type": "string",
          "description": "二级类别字段名称"
        }
      }
    },
    "OaNumberRule": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "description": "规则类型"
        },
        "value": {
          "type": "string",
          "description": "规则值"
        }
      }
    },
    "OaUserValue": {
      "type": "object",
      "properties": {
        "value": {
          "type": "array",
          "description": "成员 ID 列表",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "OaChartLayout": {
      "type": "object",
      "description": "图表在仪表盘中的位置与尺寸",
      "properties": {
        "width_height": {
          "type": "array",
          "description": "宽高 [width, height]",
          "items": {
            "type": "integer",
            "format": "uint32"
          }
        },
        "xy": {
          "type": "array",
          "description": "起点坐标 [x, y]",
          "items": {
            "type": "integer",
            "format": "uint32"
          }
        }
      }
    },
    "OaSort": {
      "type": "object",
      "description": "排序参数（GetData 接口使用）",
      "properties": {
        "desc": {
          "type": "boolean",
          "description": "是否降序"
        },
        "field_id": {
          "type": "string"
        },
        "field_title": {
          "type": "string",
          "description": "排序字段标题"
        }
      }
    },
    "OaFormulaFieldProperty": {
      "type": "object",
      "description": "公式字段属性，field_type=formula 时有效（对齐下游 FormulaFieldProperty）",
      "properties": {
        "formatter": {
          "type": "object",
          "$ref": "OaFormatter",
          "description": "展示格式（不一定与计算结果类型一致）"
        },
        "formulaModel": {
          "type": "array",
          "description": "公式项列表",
          "items": {
            "type": "object",
            "$ref": "OaFormulaItem"
          }
        }
      }
    },
    "OaConditionValue": {
      "type": "object",
      "description": "查找引用过滤条件值（对齐下游 ConditionValue）\n说明：下游中 valueImages / valueAttachment / valueUsers 等使用 google.protobuf.Value/ListValue，\n为避免上游引入 protobuf well-known types 与裸结构对不齐，统一以 JSON 字符串表达，\n由调用方自行 JSON 序列化（与 OaRecordValue.value 一致策略）。\n字段编号严格对齐下游 ConditionValue（25/26 在下游 reserved，此处也保留）。",
      "properties": {
        "valueAttachment": {
          "type": "string",
          "description": "附件，JSON 序列化字符串"
        },
        "valueBarcode": {
          "type": "object",
          "$ref": "OaStringValue",
          "description": "条码"
        },
        "valueCheckbox": {
          "type": "object",
          "$ref": "OaBoolValue",
          "description": "复选框值"
        },
        "valueCreatedTime": {
          "type": "string",
          "description": "创建时间，JSON 序列化字符串"
        },
        "valueCreatedUser": {
          "type": "string",
          "description": "创建者，JSON 序列化字符串"
        },
        "valueDateTime": {
          "type": "object",
          "$ref": "OaFilterDateTimeValue",
          "description": "日期值"
        },
        "valueEmail": {
          "type": "object",
          "$ref": "OaStringValue",
          "description": "邮箱"
        },
        "valueFormula": {
          "type": "string",
          "description": "公式，JSON 序列化字符串"
        },
        "valueImages": {
          "type": "string",
          "description": "图片，JSON 序列化字符串"
        },
        "valueLocation": {
          "type": "string",
          "description": "地理位置，JSON 序列化字符串"
        },
        "valueLookup": {
          "type": "string",
          "description": "查找引用，JSON 序列化字符串"
        },
        "valueModifiedTime": {
          "type": "string",
          "description": "修改时间，JSON 序列化字符串"
        },
        "valueModifiedUser": {
          "type": "string",
          "description": "修改者，JSON 序列化字符串"
        },
        "valueNumber": {
          "type": "object",
          "$ref": "OaNumberValue",
          "description": "数字值"
        },
        "valuePercentage": {
          "type": "object",
          "$ref": "OaNumberValue",
          "description": "百分数"
        },
        "valuePhoneNumber": {
          "type": "object",
          "$ref": "OaStringValue",
          "description": "电话"
        },
        "valueProgress": {
          "type": "string",
          "description": "进度，JSON 序列化字符串"
        },
        "valueReference": {
          "type": "object",
          "$ref": "OaStringValue",
          "description": "关联"
        },
        "valueSelects": {
          "type": "string",
          "description": "多选，JSON 序列化字符串"
        },
        "valueSingleSelect": {
          "type": "string",
          "description": "单选，JSON 序列化字符串"
        },
        "valueText": {
          "type": "object",
          "$ref": "OaStringValue",
          "description": "文本值"
        },
        "valueTitle": {
          "type": "object",
          "$ref": "OaStringValue",
          "description": "标题"
        },
        "valueTwoWayLinkRecords": {
          "type": "object",
          "$ref": "OaStringValue",
          "description": "双向关联"
        },
        "valueUrl": {
          "type": "string",
          "description": "超链接，JSON 序列化字符串"
        },
        "valueUsers": {
          "type": "string",
          "description": "成员列表，JSON 序列化字符串"
        },
        "valueUsersC": {
          "type": "string",
          "description": "成员（兼容字段），JSON 序列化字符串"
        }
      }
    },
    "OaOption": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "选项 ID"
        },
        "style": {
          "type": "integer",
          "description": "选项颜色",
          "format": "int32"
        },
        "text": {
          "type": "string",
          "description": "选项内容"
        }
      }
    },
    "OaView": {
      "type": "object",
      "description": "视图信息（只读返回，SmartSheetGetData Response 中 type=views 时返回）",
      "properties": {
        "property": {
          "type": "object",
          "$ref": "OaViewProperty",
          "description": "视图属性"
        },
        "view_id": {
          "type": "string",
