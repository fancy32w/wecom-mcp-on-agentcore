{
  "method": "sheet.create",
  "description": "新建文档，支持 doc/sheet/smartsheet 文档类型，可设置初始内容和字段",
  "request": {
    "$ref": "OaDocCreateReq"
  },
  "response": {
    "$ref": "OaDocCreateTypedRsp"
  },
  "schemas": {
    "OaLocation": {
      "type": "object",
      "description": "文档位置",
      "properties": {
        "index": {
          "type": "integer",
          "description": "位置",
          "format": "uint32"
        }
      }
    },
    "OaLookupFilter": {
      "type": "object",
      "description": "查找引用字段过滤器（对齐下游 LookupFilter）",
      "properties": {
        "conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "OaLookupCondition"
          }
        },
        "conjunction": {
          "type": "string",
          "description": "组合方式，改成 string 兼容"
        }
      }
    },
    "OaSelect": {
      "type": "object",
      "description": "单选/多选值（对齐下游 sheetapi.Select）",
      "properties": {
        "multiple": {
          "type": "boolean",
          "description": "是否为多选"
        },
        "options": {
          "type": "array",
          "description": "全部选项",
          "items": {
            "type": "object",
            "$ref": "OaSheetOption"
          }
        },
        "value": {
          "type": "array",
          "description": "选中项 ID 列表",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "OaInsertPageBreak": {
      "type": "object",
      "description": "在指定位置插入分页符",
      "properties": {
        "location": {
          "type": "object",
          "$ref": "OaLocation",
          "description": "插入的位置"
        }
      }
    },
    "OaCurrencyFieldProperty": {
      "type": "object",
      "properties": {
        "currency_type": {
          "type": "string",
          "description": "货币类型"
        },
        "decimal_places": {
          "type": "integer",
          "description": "小数点位数",
          "format": "int32"
        },
        "use_separate": {
          "type": "boolean",
          "description": "是否使用千位符"
        }
      }
    },
    "OaFormatter": {
      "type": "object",
      "description": "公式字段展示格式（Formatter，与 OaField 的属性字段一一对应）",
      "properties": {
        "field_type": {
          "type": "string",
          "description": "字段类型，可选值同 OaField.field_type\n @enum FieldType"
        },
        "property_attachment": {
          "type": "object",
          "$ref": "OaAttachmentFieldProperty"
        },
        "property_auto_number": {
          "type": "object",
          "$ref": "OaAutoNumberFieldProperty"
        },
        "property_barcode": {
          "type": "object",
          "$ref": "OaBarcodeFieldProperty"
        },
        "property_checkbox": {
          "type": "object",
          "$ref": "OaCheckboxFieldProperty"
        },
        "property_created_time": {
          "type": "object",
          "$ref": "OaCreatedTimeFieldProperty"
        },
        "property_currency": {
          "type": "object",
          "$ref": "OaCurrencyFieldProperty"
        },
        "property_date_time": {
          "type": "object",
          "$ref": "OaDateTimeFieldProperty"
        },
        "property_formula": {
          "type": "object",
          "$ref": "OaFormulaFieldProperty"
        },
        "property_location": {
          "type": "object",
          "$ref": "OaLocationFieldProperty"
        },
        "property_lookup": {
          "type": "object",
          "$ref": "OaLookupFieldProperty"
        },
        "property_modified_time": {
          "type": "object",
          "$ref": "OaModifiedTimeFieldProperty"
        },
        "property_number": {
          "type": "object",
          "$ref": "OaNumberFieldProperty"
        },
        "property_percentage": {
          "type": "object",
          "$ref": "OaPercentageFieldProperty"
        },
        "property_progress": {
          "type": "object",
          "$ref": "OaProgressFieldProperty"
        },
        "property_reference": {
          "type": "object",
          "$ref": "OaReferenceFieldProperty"
        },
        "property_select": {
          "type": "object",
          "$ref": "OaSelectFieldProperty"
        },
        "property_single_select": {
          "type": "object",
          "$ref": "OaSingleSelectFieldProperty"
        },
        "property_two_way_link_records": {
          "type": "object",
          "$ref": "OaTwoWayLinkRecordsFieldProperty"
        },
        "property_url": {
          "type": "object",
          "$ref": "OaUrlFieldProperty"
        },
        "property_user": {
          "type": "object",
          "$ref": "OaUserFieldProperty"
        },
        "property_ww_group": {
          "type": "object",
          "$ref": "OaWwGroupFieldProperty"
        }
      }
    },
    "OaNumberRule": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "description": "规则类型"
        },
        "value": {
          "type": "string",
          "description": "规则值"
        }
      }
    },
    "OaNumberValue": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number",
          "description": "数字值",
          "format": "double"
        }
      }
    },
    "OaTwoWayLinkRecordsFieldProperty": {
      "type": "object",
      "description": "双向关联字段属性，field_type=twowaylinkrecords 时有效（对齐下游 TwoWayLinkRecordsFieldProperty）",
      "properties": {
        "back_field_id": {
          "type": "string",
          "description": "双向关联的对应列 ID"
        },
        "back_field_title": {
          "type": "string",
          "description": "双向关联的对应列标题"
        },
        "field_id": {
          "type": "string",
          "description": "关联的字段 ID"
        },
        "field_title": {
          "type": "string",
          "description": "关联的字段标题"
        },
        "is_multiple": {
          "type": "boolean",
          "description": "是否允许多选"
        },
        "pad_id": {
          "type": "string",
          "description": "关联的文档 ID，为空时表示关联当前文档"
        },
        "sub_id": {
          "type": "string",
          "description": "关联的子表 ID，为空时表示关联本子表"
        },
        "sub_title": {
          "type": "string",
          "description": "关联的子表标题"
        },
        "view_id": {
          "type": "string",
          "description": "视图 ID"
        }
      }
    },
    "OaUrlFieldProperty": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "description": "超链接展示样式"
        }
      }
    },
    "OaWwGroupFieldProperty": {
      "type": "object",
      "properties": {
        "allow_multiple": {
          "type": "boolean",
          "description": "是否允许多个群聊"
        }
      }
    },
    "OaReferenceFieldProperty": {
      "type": "object",
      "properties": {
        "field_title": {
          "type": "string",
          "description": "字段标题"
        },
        "filed_id": {
          "type": "string",
          "description": "关联的字段 ID"
        },
        "is_multiple": {
          "type": "boolean",
          "description": "是否允许多选"
        },
        "sub_id": {
          "type": "string",
          "description": "关联的子表 ID"
        },
        "sub_title": {
          "type": "string",
          "description": "子表标题"
        },
        "view_id": {
          "type": "string",
          "description": "视图 ID"
        }
      }
    },
    "OaStringValue": {
      "type": "object",
      "properties": {
        "value": {
          "type": "array",
          "description": "字符串值列表",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "OaBoolValue": {
      "type": "object",
      "properties": {
        "value": {
          "type": "boolean",
          "description": "布尔值"
        }
      }
    },
    "OaModifiedTimeFieldProperty": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "description": "日期格式"
        }
      }
    },
    "OaNumberFieldProperty": {
      "type": "object",
      "description": "FieldProperty 相关",
      "properties": {
        "decimal_places": {
          "type": "integer",
          "description": "小数点位数",
          "format": "int32"
        },
        "use_separate": {
          "type": "boolean",
          "description": "是否使用千位符"
        }
      }
    },
    "OaLookupFieldProperty": {
      "type": "object",
      "description": "查找引用字段属性，field_type=lookup 时有效（对齐下游 LookupFieldProperty）",
      "properties": {
        "filter": {
          "type": "object",
          "$ref": "OaLookupFilter",
          "description": "过滤器"
        },
        "link_records_field_id": {
          "type": "string",
          "description": "关联列字段 ID"
        },
        "link_records_field_title": {
          "type": "string",
          "description": "关联列字段标题"
        },
        "lookup_field_id": {
          "type": "string",
          "description": "引用列查找的字段 ID"
        },
        "lookup_field_title": {
          "type": "string",
          "description": "引用列查找的字段标题"
        },
        "lookup_sub_id": {
          "type": "string",
          "description": "引用的子表 ID"
        },
        "lookup_sub_title": {
          "type": "string",
          "description": "引用的子表标题"
        },
        "rollup_type": {
          "type": "string",
          "description": "统计类型，可选值参见下游 RollupType 枚举名：\n \"original\"、\"unique\"、\"sum\"、\"count\"、\"count_unique\"、\"average\"、\"max\"、\"min\"\n 或大写形式：\"ROLLUP_TYPE_ORIGINAL\" 等\n @enum RollupType"
        }
      }
    },
    "OaFilterDateTimeValue": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "description": "日期类型"
        },
        "value": {
          "type": "array",
          "description": "日期值",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "OaSheetOption": {
      "type": "object",
      "description": "单/多选选项（对齐下游 sheetapi.SheetOption）",
      "properties": {
        "color": {
          "type": "object",
          "$ref": "OaCellColor",
          "description": "选项颜色"
        },
        "id": {
          "type": "string",
          "description": "选项 ID"
        },
        "text": {
          "type": "string",
          "description": "选项文本"
        }
      }
    },
    "OaAutoNumberFieldProperty": {
      "type": "object",
      "properties": {
        "reformat_existing_record": {
          "type": "boolean",
          "description": "是否应用于已有编号"
        },
        "rules": {
          "type": "array",
          "description": "自定义规则",
          "items": {
            "type": "object",
            "$ref": "OaNumberRule"
          }
        },
        "type": {
          "type": "string",
          "description": "编号类型"
        }
      }
    },
    "OaProgressFieldProperty": {
      "type": "object",
      "properties": {
        "decimal_places": {
          "type": "integer",
          "description": "小数位数",
          "format": "int32"
        }
      }
    },
    "OaRowData": {
      "type": "object",
      "description": "行数据",
      "properties": {
        "values": {
          "type": "array",
          "description": "单元格数据列表",
          "items": {
            "type": "object",
            "$ref": "OaCellData"
          }
        }
      }
    },
    "OaConditionValue": {
      "type": "object",
      "description": "查找引用过滤条件值（对齐下游 ConditionValue）\n说明：下游中 valueImages / valueAttachment / valueUsers 等使用 google.protobuf.Value/ListValue，\n为避免上游引入 protobuf well-known types 与裸结构对不齐，统一以 JSON 字符串表达，\n由调用方自行 JSON 序列化（与 OaRecordValue.value 一致策略）。\n字段编号严格对齐下游 ConditionValue（25/26 在下游 reserved，此处也保留）。",
      "properties": {
        "valueAttachment": {
          "type": "string",
          "description": "附件，JSON 序列化字符串"
        },
        "valueBarcode": {
          "type": "object",
          "$ref": "OaStringValue",
          "description": "条码"
        },
        "valueCheckbox": {
          "type": "object",
          "$ref": "OaBoolValue",
          "description": "复选框值"
        },
        "valueCreatedTime": {
          "type": "string",
          "description": "创建时间，JSON 序列化字符串"
        },
        "valueCreatedUser": {
          "type": "string",
          "description": "创建者，JSON 序列化字符串"
        },
        "valueDateTime": {
          "type": "object",
          "$ref": "OaFilterDateTimeValue",
          "description": "日期值"
        },
        "valueEmail": {
          "type": "object",
          "$ref": "OaStringValue",
          "description": "邮箱"
        },
        "valueFormula": {
          "type": "string",
          "description": "公式，JSON 序列化字符串"
        },
        "valueImages": {
          "type": "string",
          "description": "图片，JSON 序列化字符串"
        },
        "valueLocation": {
          "type": "string",
          "description": "地理位置，JSON 序列化字符串"
        },
        "valueLookup": {
          "type": "string",
          "description": "查找引用，JSON 序列化字符串"
        },
        "valueModifiedTime": {
          "type": "string",
          "description": "修改时间，JSON 序列化字符串"
        },
        "valueModifiedUser": {
          "type": "string",
          "description": "修改者，JSON 序列化字符串"
        },
        "valueNumber": {
          "type": "object",
          "$ref": "OaNumberValue",
          "description": "数字值"
        },
        "valuePercentage": {
          "type": "object",
          "$ref": "OaNumberValue",
          "description": "百分数"
        },
        "valuePhoneNumber": {
          "type": "object",
          "$ref": "OaStringValue",
          "description": "电话"
        },
        "valueProgress": {
          "type": "string",
          "description": "进度，JSON 序列化字符串"
        },
        "valueReference": {
          "type": "object",
          "$ref": "OaStringValue",
          "description": "关联"
        },
        "valueSelects": {
          "type": "string",
          "description": "多选，JSON 序列化字符串"
        },
        "valueSingleSelect": {
          "type": "string",
          "description": "单选，JSON 序列化字符串"
        },
        "valueText": {
          "type": "object",
          "$ref": "OaStringValue",
          "description": "文本值"
        },
        "valueTitle": {
          "type": "object",
          "$ref": "OaStringValue",
          "description": "标题"
        },
        "valueTwoWayLinkRecords": {
          "type": "object",
          "$ref": "OaStringValue",
          "description": "双向关联"
        },
        "valueUrl": {
          "type": "string",
          "description": "超链接，JSON 序列化字符串"
        },
        "valueUsers": {
          "type": "string",
          "description": "成员列表，JSON 序列化字符串"
        },
        "valueUsersC": {
          "type": "string",
          "description": "成员（兼容字段），JSON 序列化字符串"
        }
      }
    },
    "OaLookupConditionMatchValue": {
      "type": "object",
      "description": "查找引用匹配值（对齐下游 LookupConditionMatchValue）",
      "properties": {
        "FieldTitle": {
          "type": "string",
          "description": "@fieldId 映射"
        },
        "computedKeyType": {
          "type": "string",
          "description": "计算 key 的类型"
        },
        "fieldId": {
          "type": "string",
          "description": "和对应列比较时生效"
        },
        "value": {
          "type": "object",
          "$ref": "OaConditionValue",
          "description": "和具体值比较时生效"
        },
        "valueType": {
          "type": "string",
          "description": "值类型"
        }
      }
    },
    "OaTextProperty": {
      "type": "object",
      "description": "文本属性",
      "properties": {
        "background_color": {
          "type": "string",
          "description": "文字的背景颜色，十六进制 RRGGBB 格式"
        },
        "bold": {
          "type": "boolean",
          "description": "是否加粗"
        },
        "color": {
          "type": "string",
          "description": "文字颜色，十六进制 RRGGBB 格式"
        }
      }
    },
    "OaBarcodeFieldProperty": {
      "type": "object",
      "properties": {
        "mobile_scan_only": {
          "type": "boolean",
          "description": "仅限手机扫描录入"
        }
      }
    },
    "OaDateTimeFieldProperty": {
      "type": "object",
      "properties": {
        "auto_fill": {
          "type": "boolean",
          "description": "新建记录时是否自动填充时间"
        },
        "format": {
          "type": "string",
          "description": "日期格式"
        }
      }
    },
    "OaOption": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "选项 ID"
        },
        "style": {
          "type": "integer",
          "description": "选项颜色",
          "format": "int32"
        },
        "text": {
          "type": "string",
          "description": "选项内容"
        }
      }
    },
    "OaCellFormat": {
      "type": "object",
      "description": "单元格格式",
      "properties": {
        "borders": {
          "type": "object",
          "$ref": "OaCellBorders",
          "description": "边框设置"
        },
        "horizontal_alignment": {
          "type": "string",
          "description": "水平对齐方式，可选值参见 sheetapi.HorizontalAlignment 枚举名：\n \"HORIZONTAL_ALIGNMENT_UNSPECIFIED\"（默认左对齐）、\"LEFT\"（左对齐）、\n \"HORIZONTAL_CENTER\"（居中对齐）、\"RIGHT\"（右对齐）\n @enum HorizontalAlignment"
        },
        "padding": {
          "type": "object",
          "$ref": "OaCellPadding",
          "description": "内边距"
        },
        "text_format": {
          "type": "object",
          "$ref": "OaCellTextFormat",
          "description": "文本格式"
        },
        "vertical_alignment": {
          "type": "string",
          "description": "垂直对齐方式，可选值参见 sheetapi.VerticalAlignment 枚举名：\n \"VERTICAL_ALIGNMENT_UNSPECIFIED\"（默认居中对齐）、\"TOP\"（上对齐）、\n \"VERTICAL_CENTER\"（居中对齐）、\"BOTTOM\"（下对齐）\n @enum VerticalAlignment"
        }
      }
    },
    "OaCellBorders": {
      "type": "object",
      "description": "边框设置",
      "properties": {
        "bottom": {
          "type": "object",
          "$ref": "OaCellBorder",
          "description": "下边框"
        },
        "left": {
          "type": "object",
          "$ref": "OaCellBorder",
          "description": "左边框"
        },
        "right": {
          "type": "object",
          "$ref": "OaCellBorder",
          "description": "右边框"
        },
        "top": {
          "type": "object",
          "$ref": "OaCellBorder",
          "description": "上边框"
        }
      }
    },
    "OaCellPadding": {
      "type": "object",
      "description": "单元格内边距",
      "properties": {
        "bottom": {
          "type": "integer",
          "description": "下内边距",
          "format": "int32"
        },
        "left": {
          "type": "integer",
          "description": "左内边距",
          "format": "int32"
        },
        "right": {
          "type": "integer",
          "description": "右内边距",
          "format": "int32"
        },
        "top": {
          "type": "integer",
          "description": "上内边距",
          "format": "int32"
        }
      }
    },
    "OaInsertText": {
      "type": "object",
      "description": "在指定位置插入文本",
      "properties": {
        "location": {
          "type": "object",
          "$ref": "OaLocation",
          "description": "插入的位置"
        },
        "text": {
          "type": "string",
          "description": "要插入的文本"
        }
      }
    },
    "OaCreatedTimeFieldProperty": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "description": "日期格式"
        }
      }
    },
    "OaDocCreateReq": {
      "type": "object",
      "description": "OaDocCreate (新建文档)",
      "properties": {
        "content": {
          "type": "string",
          "description": "纯文本初始内容，doc_type=doc 时有效，不传则不设置初始内容",
          "maxLength": 1048576
        },
        "content_path": {
          "type": "string",
          "description": "同 file_path，兼容模型传 content_path 字段名",
          "x-wecom-file-upload": {},
          "hidden": true
        },
        "content_type": {
          "type": "string",
          "description": "内容格式，doc_type=doc 时传 text 不传则默认 text",
          "enum": [
            "text",
            "markdown"
          ]
        },
        "doc_name": {
          "type": "string",
          "description": "文档标题",
          "minLength": 1,
          "maxLength": 255
        },
        "doc_requests": {
          "type": "array",
          "description": "document 节点编辑写入，doc_type=doc 时有效，与 content 二选一，不传则不设置初始内容",
          "items": {
            "type": "object",
            "$ref": "OaUpdateRequest"
          },
          "minItems": 0,
          "maxItems": 100
        },
        "doc_type": {
          "type": "string",
          "description": "文档类型，不传则默认为 doc",
          "enum": [
            "doc",
            "sheet",
            "smartsheet"
          ]
        },
        "fields": {
          "type": "array",
